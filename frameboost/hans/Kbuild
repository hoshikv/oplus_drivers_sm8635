endif
#MTK in tree
ifeq ($(CONFIG_OPLUS_FEATURE_HANS_GKI), m)
obj-$(CONFIG_OPLUS_FEATURE_HANS_GKI)          += oplus_hans.o
oplus_hans-objs                           += hans_help.o hans.o hans_netfilter.o
endif
